# Simulators standing in for physical hardware.
# In a real fab NONE of these containers exist — they are replaced by the
# actual controller and tools. Keeping them as separate images makes that
# substitution obvious.
#
# This image builds hsms_sim only. It previously also tried to build
# mes_producer and equipment_sim from src/mes_producer_main.cpp and
# src/equipment_sim_main.cpp — neither file has ever existed in this tree, and
# both were compiled with `|| true`, so the build "succeeded" and produced
# nothing. The MES feed is bench/tools/sim_feed.py, which drives the same wire
# format from the simulator we already trust; there is no C++ producer to
# restore.
#
# No `|| true` here. A build step that cannot fail cannot tell you anything.
FROM ubuntu:24.04 AS build
RUN apt-get update && apt-get install -y --no-install-recommends \
      g++ librdkafka-dev libzmq3-dev && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY include/ include/
COPY src/ src/
RUN g++ -std=c++20 -O2 -pthread -Iinclude \
        src/hsms_sim_main.cpp -o /hsms_sim

FROM ubuntu:24.04
RUN apt-get update && apt-get install -y --no-install-recommends \
      librdkafka++1 libzmq5 && rm -rf /var/lib/apt/lists/*
COPY --from=build /hsms_sim /app/
# Licences travel with the binaries: Apache-2.0 (OR-Tools) and the other
# licences here require the notice be carried by anything distributed.
# Generated by scripts/gen_third_party_notices.py.
COPY legal/ /app/legal/

RUN useradd -r -u 10003 sim
USER sim
