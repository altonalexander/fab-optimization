# Copy to .env (git-ignored). Read by docker-compose.prod.yml.
POSTGRES_PASSWORD=change-me

# Optional: the dashboard assistant (Claude on Vertex AI). Leave unset to
# disable it; the rest of the dashboard does not depend on it.
#GOOGLE_CLOUD_PROJECT=
#VERTEX_REGION=us-east5
#GCP_SA_KEY=/path/to/sa.json

# Public ingress via Cloudflare Tunnel (docker-compose.prod.yml, --profile tunnel).
#CLOUDFLARE_TUNNEL_TOKEN=

# Demo lifecycle. The feed runs to FEED_DAYS then restarts from the day-90
# warm-up checkpoint (dashboards get a "reset" modal). A checkpoint is per
# horizon, so the first start at a new FEED_DAYS re-simulates the warm-up once
# (~10 min). With no viewer for IDLE_PAUSE_SECONDS the feed pauses.
#FEED_DAYS=290       # 200 days of run after the day-90 checkpoint
#IDLE_PAUSE_SECONDS=600

# Access gate (login page: access codes + magic links). Codes work with no
# mail setup; magic links need Mailgun (or SMTP as a fallback). Admins =
# sign-ins from AUTH_ADMIN_DOMAIN.
PUBLIC_URL=https://fab.example.com
#MAILGUN_API_KEY=
#MAILGUN_DOMAIN=mg.example.com
#MAILGUN_API_BASE=https://api.mailgun.net   # api.eu.mailgun.net for EU accounts
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_USER=fab-support@frontanalytics.com
#SMTP_PASS=
#MAIL_FROM=fab-support@frontanalytics.com
#AUTH_ADMIN_DOMAIN=frontanalytics.com
