# ZONE 3 — the only zone a human reaches.
FROM node:22-alpine AS build
WORKDIR /src
COPY ui/package.json ./
RUN npm install
COPY ui/ .
RUN npm run build

FROM nginx:alpine
COPY --from=build /src/dist /usr/share/nginx/html
# Licences travel with the binaries: Apache-2.0 (OR-Tools) and the other
# licences here require the notice be carried by anything distributed.
# Generated by scripts/gen_third_party_notices.py.
COPY legal/ /usr/share/legal/

COPY infra/nginx.conf /etc/nginx/conf.d/default.conf
