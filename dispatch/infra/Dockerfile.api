# ZONE 2<->3 BOUNDARY — read-only mirror + scenario runner.
#
# Two-stage: the C++ scenario binary is built and copied in, so the API calls
# the REAL planner rather than reimplementing dispatch logic in Python.
# Build context is the REPO ROOT (see docker-compose.yml): besides its own
# code the API serves the Routes tab (viz/routes_lvhm.json + the SMT2020
# route tables), the Results tab (bench/results) and the Slate tab
# (libfabslate.so through bench/tools/fabslate.py), none of which live under
# dispatch/api.
FROM ubuntu:24.04 AS cxx
ARG ORTOOLS_URL=https://github.com/google/or-tools/releases/download/v9.15/or-tools_amd64_ubuntu-24.04_cpp_v9.15.6755.tar.gz
RUN apt-get update && apt-get install -y --no-install-recommends \
      g++ cmake make curl ca-certificates && rm -rf /var/lib/apt/lists/*
RUN if [ -n "$ORTOOLS_URL" ]; then \
      mkdir -p /opt && curl -fsSL "$ORTOOLS_URL" -o /tmp/ortools.tgz \
      && tar xzf /tmp/ortools.tgz -C /opt && rm /tmp/ortools.tgz \
      && mv /opt/or-tools_* /opt/or-tools; fi
WORKDIR /src/dispatch
COPY dispatch/include/ include/
COPY dispatch/src/ src/
COPY dispatch/CMakeLists.txt dispatch/build-slate.sh ./
RUN g++ -std=c++20 -O2 -pthread -Iinclude src/scenario_main.cpp -o /fab_scenario \
    && ORTOOLS_ROOT=/opt/or-tools bash build-slate.sh

FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends libstdc++6 libgomp1 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY dispatch/api/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY dispatch/api/ .
COPY --from=cxx /fab_scenario /app/fab_scenario
COPY --from=cxx /src/dispatch/libfabslate.so /app/libfabslate.so
COPY --from=cxx /opt/or-tools/lib/ /opt/or-tools/lib/
COPY bench/tools/fabslate.py /app/bench/tools/fabslate.py
COPY bench/results/ /app/bench/results/
COPY viz/routes_lvhm.json /app/viz/routes_lvhm.json
COPY data/smt2020/ /app/data/smt2020/
# Licences travel with the binaries: Apache-2.0 (OR-Tools) and the other
# licences here require the notice be carried by anything distributed.
# Generated by scripts/gen_third_party_notices.py.
COPY dispatch/legal/ /app/legal/

# Every file the API reads, spelled out. The in-code defaults are relative to
# main.py's place in the source tree and resolve to nowhere in the image.
ENV READ_ONLY=true \
    SCENARIO_BIN=/app/fab_scenario \
    TOOL_CONFIG=/etc/fab/fab_tools.json \
    FLOORPLAN_FILE=/etc/fab/floorplan.json \
    ZONES_FILE=/etc/fab/zones.yaml \
    ROUTES_FILE=/app/viz/routes_lvhm.json \
    PART_TABLE=/app/data/smt2020/SMT2020_LVHM/part.txt \
    BENCH_RESULTS=/app/bench/results \
    BENCH_TOOLS=/app/bench/tools \
    FABSLATE_LIB=/app/libfabslate.so \
    LD_LIBRARY_PATH=/opt/or-tools/lib
RUN useradd -r -u 10004 api \
    && mkdir -p /var/run/fab-sim && chown api:api /var/run/fab-sim && chmod 1777 /var/run/fab-sim
USER api
EXPOSE 8000
# gthread, ONE worker, many threads.
#   * not gevent: it monkey-patches threading, so the Kafka mirror's blocking
#     confluent_kafka poll() runs as a greenlet and starves every request --
#     the API accepted connections and never answered.
#   * one worker: the mirror is in-process state. Two workers would run two
#     consumers in the same group, so Kafka splits partitions between them and
#     each process sees half the fab.
#   * threads: SSE holds one thread per open dashboard for its lifetime.
CMD ["gunicorn","-k","gthread","-w","1","--threads","64","-b","0.0.0.0:8000","--timeout","120","main:app"]
